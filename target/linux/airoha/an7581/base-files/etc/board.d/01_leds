. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
airoha,an7581-evb)
	ucidef_set_led_usbport "usb1" "USB 1" "green:usb-1" "usb1-port1" "usb2-port1"
	ucidef_set_led_usbport "usb2" "USB 2" "green:usb-2" "usb3-port1" "usb4-port1"
	;;
gemtek,w1700k-ubi)
	ucidef_set_led_netdev "lan3-yellow" "lan3" "yellow:lan-3" "lan3" "link_10 link_100"
	ucidef_set_led_netdev "lan3-green" "lan3" "green:lan-3" "lan3" "link_1000 tx rx"
	ucidef_set_led_netdev "lan4-yellow" "lan4" "yellow:lan-4" "lan4" "link_10 link_100"
	ucidef_set_led_netdev "lan4-green" "lan4" "green:lan-4" "lan4" "link_1000 tx rx"
	;;
gemtek,w1701k-ubi)
	ucidef_set_led_netdev "lan1-green" "lan1 2.5G" "mt7530_dsa-0:0e:green:lan" "lan1" "link_2500 tx rx"
	ucidef_set_led_netdev "lan1-amber" "lan1 100/1000" "mt7530_dsa-0:0e:amber:lan" "lan1" "link_100 link_1000"
	ucidef_set_led_netdev "wan-green" "wan 2.5G" "mt7530_dsa-0:0f:green:wan" "wan" "link_2500 tx rx"
	ucidef_set_led_netdev "wan-amber" "wan 100/1000" "mt7530_dsa-0:0f:amber:wan" "wan" "link_100 link_1000"
	;;
esac

board_config_flush

exit 0
