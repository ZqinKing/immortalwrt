#!/bin/sh
# Fan local receive processing out to online non-boot cores (companion to the
# nss-up stage that does this at bring-up). Single-core systems get mask 0.
# VAP netdevs are recreated on every wifi reload, which silently resets their
# rps_cpus - re-apply whenever a delivery netdev (re)appears.
[ "$ACTION" = "add" ] || exit 0

# Delivery netdevs: the Wi-Fi VAPs and any bridge (whatever its name).
case "$DEVICENAME" in
	phy*-ap*) ;;
	*) [ -d "/sys/class/net/$DEVICENAME/bridge" ] || exit 0 ;;
esac

# Applied unconditionally: writing rps_cpus is harmless in host mode, and
# there is no reliable ordering between a VAP's netdev-add event and the
# firmware arming - gating on fw_mask here races and leaves the mask at 0
# for any VAP created in that window (seen at boot).
rps_mask=0
for cpu in /sys/devices/system/cpu/cpu[1-9]*; do
	[ -d "$cpu" ] || continue
	[ "$(cat "$cpu/online" 2>/dev/null || echo 1)" = 1 ] || continue
	n=${cpu##*/cpu}
	rps_mask=$((rps_mask | (1 << n)))
done
rps_mask=$(printf %x "$rps_mask")

echo "$rps_mask" > "/sys/class/net/$DEVICENAME/queues/rx-0/rps_cpus" 2>/dev/null
